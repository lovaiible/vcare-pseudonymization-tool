{
  "name": "vcare-request-pseudonymizer-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node browser/scripts/assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node browser/scripts/assets.mjs --verify && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test browser/tests/*.test.mjs",
    "evaluate": "node browser/scripts/evaluate.mjs",
    "check": "npm test && npm run build",
    "build:verification": "node browser/scripts/assets.mjs --verify && vite build --mode verification",
    "preview:verification": "vite preview --mode verification --host 127.0.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "vite": "7.3.7"
  }
}
